        "x-readme": {
          "code-samples": [
            {
              "code": "{\n  \"name\": \"代币分发\",\n  \"method\": \"POST\",\n  \"path\": \"https://api-bot-v1.dbotx.com/coin_tools/distribute\",\n  \"params\": {\n    \"header\": [\n      \"x-api-key:YOUR_API_KEY\"\n    ]\n  },\n  \"body\": {\n    \"chain\": \"solana\",\n    \"fromWalletId\": \"lvg40po10005q7\",\n    \"toList\": [\n      {\n        \"address\": \"5JVa7ERnqbqNkd1RKanZiPukSpW85vRgA8E8WLiYjS9n\",\n        \"amountUI\": 0.11\n      },\n      {\n        \"address\": \"KLwM1VDAD3HNTWAa9EYCLn8hdaYGWvFWeGUGWi9Hdnz\",\n        \"amountUI\": 0.12\n      }\n    ],\n    \"token\": \"\",\n    \"gasFeeDelta\": 0,\n    \"maxFeePerGas\": 0,\n    \"priorityFee\": 0.001\n  },\n  \"response\": {\n    \"err\": false,\n    \"res\": [\n      {\n        \"err\": false,\n        \"msg\": \"OK\",\n        \"toList\": [\n          {\n            \"address\": \"4GPFnQ1Yo9NkWmFgDgtg9VpM4BSbfanNw5G5cprSUnx3\",\n            \"amountUI\": 0.11\n          },\n          {\n            \"address\": \"Ba1RxEwiiLSwb8CHqPGa4YJrq4JebaJbBDvXMX2RAGiB\",\n            \"amountUI\": 0.12\n          },\n          {\n            \"address\": \"GuFfw7KHoae3w9gQJT5udjkMatK6Sdzkz1h39cUKA4oW\",\n            \"amountUI\": 0.13\n          },\n          {\n            \"address\": \"G1B6yupiSnQia349a8T6V5WbnRJo4K7q91P7jG44PRN2\",\n            \"amountUI\": 0.14\n          },\n          {\n            \"address\": \"Fv3WiFNQDWcjXESthBxUAtDrQYgncLWwVLJnvhUoi8mw\",\n            \"amountUI\": 0.15\n          }\n        ],\n        \"txid\": \"29zhzqfqRtjb9FPyi9cctsW2ESa6s6YCFKgLbivjdKSfn3suUMxNTjDG77MpFifq2jmc1ypxoZbTD8mGTh51UaSA\",\n        \"decimals\": 9\n      },\n      {\n        \"err\": false,\n        \"msg\": \"OK\",\n        \"toList\": [\n          {\n            \"address\": \"AcazJW66GN2Tk6Wm2x2n1raTLBjVXnZYKwnreCBdosCi\",\n            \"amountUI\": 0.02\n          },\n          {\n            \"address\": \"BYnVrf7oRwFkNCSzshEDA5Xhf19Z4beHeKNaD6T4eydS\",\n            \"amountUI\": 0.03\n          }\n        ],\n        \"txid\": \"2PDzSt76aBvW8vUUty7ChP3nxfEHAqo9sHJEZprEEF5MR1gmDqGyrjijkV449y9cskRKKiKtLUU7cKU4fUgcstMo\",\n        \"decimals\": 9\n      }\n    ]\n  }\n}",
              "language": "json",
              "name": ""
            },
            {
              "code": "curl --location --request POST 'https://api-bot-v1.dbotx.com/coin_tools/distribute' \\\n     --header 'x-api-key: YOUR_API_KEY' \\\n     --header 'Content-Type: application/json' \\\n     --data-raw '{\"chain\":\"solana\",\"fromWalletId\":\"lvg40po10005q7\",\"toList\":[{\"address\":\"5JVa7ERnqbqNkd1RKanZiPukSpW85vRgA8E8WLiYjS9n\",\"amountUI\":0.11},{\"address\":\"KLwM1VDAD3HNTWAa9EYCLn8hdaYGWvFWeGUGWi9Hdnz\",\"amountUI\":0.12}],\"token\":\"\",\"gasFeeDelta\":0,\"maxFeePerGas\":0,\"priorityFee\":0.001}'",
              "language": "shell",
              "name": ""
            },
            {
              "code": "import requests\n\nurl = \"https://api-bot-v1.dbotx.com/coin_tools/distribute\"\nheaders = {\n    'x-api-key': 'YOUR_API_KEY',\n    'Content-Type': 'application/json'\n}\npayload = {\n    'chain': 'solana',\n    'fromWalletId': 'lvg40po10005q7',\n    'toList': [\n        { 'address': '5JVa7ERnqbqNkd1RKanZiPukSpW85vRgA8E8WLiYjS9n', 'amountUI': 0.11 },\n        { 'address': 'KLwM1VDAD3HNTWAa9EYCLn8hdaYGWvFWeGUGWi9Hdnz', 'amountUI': 0.12 }\n    ],\n    'token': '',\n    'gasFeeDelta': 0,\n    'maxFeePerGas': 0,\n    'priorityFee': 0.001\n}\nresponse = requests.post(url, headers=headers, json=payload)\nprint(response.text)",
              "language": "python",
              "name": ""
            },
            {
              "code": "const fetch = require('node-fetch');\n\nasync function makeAPICall() {\n  const url = 'https://api-bot-v1.dbotx.com/coin_tools/distribute';\n  const apiKey = 'YOUR_API_KEY';\n  const payload = {\n    chain: 'solana',\n    fromWalletId: 'lvg40po10005q7',\n    toList: [\n      { address: '5JVa7ERnqbqNkd1RKanZiPukSpW85vRgA8E8WLiYjS9n', amountUI: 0.11 },\n      { address: 'KLwM1VDAD3HNTWAa9EYCLn8hdaYGWvFWeGUGWi9Hdnz', amountUI: 0.12 }\n    ],\n    token: '',\n    gasFeeDelta: 0,\n    maxFeePerGas: 0,\n    priorityFee: 0.001\n  };\n\n  try {\n    const response = await fetch(url, {\n      method: 'POST',\n      headers: {\n        'x-api-key': apiKey,\n        'Content-Type': 'application/json'\n      },\n      body: JSON.stringify(payload)\n    });\n\n    if (!response.ok) {\n      throw new Error(`HTTP error! Status: ${response.status}`);\n    }\n\n    const data = await response.json();\n    console.log(JSON.stringify(data, null, 2));\n  } catch (error) {\n    console.error('Error:', error);\n  }\n}\n\nmakeAPICall();",
              "language": "node",
              "name": ""
            }

                  "fromWalletId": {
                    "type": "string",
                    "description": "分发代币的钱包id"
                  },
                  "toList": {
                    "type": "array",
                    "description": "接收代币的地址及数量",
                    "items": {
                      "type": "object",
                      "properties": {
                        "address": {
                          "type": "string",
                          "description": "接收代币的地址"
                        },
                        "amountUI": {
                          "type": "number",
                          "description": "接收代币的数量"
                        }
                      },
                      "required": [
                        "address",
                        "amountUI"
                      ]
                    }
                  },
                  "token": {
                    "type": "string",
                    "description": "需要分发的代币地址，空字符串表示分发当前链的主币"
                  },
                  "gasFeeDelta": {
                    "type": "number",
                    "description": "额外增加的gas (Gwei)，对EVM链有效"
                  },
                  "maxFeePerGas": {
                    "type": "number",
                    "description": "基础gas超过此值时将不进行交易 (Gwei)，对EVM链有效"
                  },
                  "priorityFee": {
                    "type": "number",
                    "description": "优先费 (SOL)，对Solana有效，空字符串表示使用自动优先费"
                  }
                },
                "required": [
                  "chain",
                  "fromWalletId",
                  "toList",
                  "token",
                  "gasFeeDelta",
                  "maxFeePerGas",
                  "priorityFee"
                ]
              }
            }
          }
        }
